{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-harness.dev/contracts/acceptance-criteria.schema.json",
  "title": "Acceptance Criteria",
  "type": "object",
  "required": ["schema_version", "work_item_id", "criteria"],
  "properties": {
    "schema_version": {"const": 1},
    "work_item_id": {"type": "string"},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "given", "when", "then", "priority"],
        "properties": {
          "id": {"type": "string"},
          "given": {"type": "string"},
          "when": {"type": "string"},
          "then": {"type": "string"},
          "priority": {"enum": ["must", "should", "could"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}

