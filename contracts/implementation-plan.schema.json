{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-harness.dev/contracts/implementation-plan.schema.json",
  "title": "Implementation Plan",
  "type": "object",
  "required": ["schema_version", "work_item_id", "design", "modules", "steps", "scope", "verification", "rollback", "risks"],
  "properties": {
    "schema_version": {"const": 1},
    "work_item_id": {"type": "string"},
    "design": {"type": "string", "minLength": 1},
    "modules": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "acceptance_criteria"],
        "properties": {
          "id": {"type": "string"},
          "description": {"type": "string"},
          "acceptance_criteria": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "scope": {
      "type": "object",
      "required": ["allowed_modules", "protected_paths", "expected_file_changes", "max_file_changes_without_replan"],
      "properties": {
        "allowed_modules": {"type": "array", "items": {"type": "string"}},
        "protected_paths": {"type": "array", "items": {"type": "string"}},
        "expected_file_changes": {"type": "integer", "minimum": 0},
        "max_file_changes_without_replan": {"type": "integer", "minimum": 1}
      }
    },
    "verification": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "rollback": {"type": "string", "minLength": 1},
    "risks": {"type": "array", "items": {"type": "object"}}
  }
}

