{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-harness.dev/contracts/work-item.schema.json",
  "title": "Work Item",
  "type": "object",
  "required": ["schema_version", "id", "type", "title", "state", "profile", "risk", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "type": {"enum": ["feature", "bugfix", "hotfix", "refactoring", "migration", "spike", "release"]},
    "title": {"type": "string", "minLength": 1},
    "state": {"enum": ["draft", "discovery", "ready_for_development", "in_development", "ready_for_validation", "validation_in_progress", "changes_requested", "ready_for_delivery", "delivered", "blocked", "approval_required", "cancelled", "superseded"]},
    "profile": {"enum": ["prototype", "standard", "strict", "hotfix"]},
    "risk": {
      "type": "object",
      "required": ["level", "factors"],
      "properties": {
        "level": {"enum": ["low", "medium", "high", "critical"]},
        "factors": {"type": "array", "items": {"type": "string"}}
      }
    },
    "created_at": {"type": "string"},
    "stages": {"type": "object"},
    "approvals": {"type": "array", "items": {"type": "object"}}
  }
}

