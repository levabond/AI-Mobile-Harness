{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-harness.dev/adapters/adapter.schema.json",
  "title": "Mobile Harness Adapter",
  "type": "object",
  "required": ["version", "name", "platform", "detect", "capabilities"],
  "properties": {
    "version": {"const": 1},
    "name": {"type": "string"},
    "platform": {"type": "string"},
    "detect": {"type": "array", "items": {"type": "string"}},
    "capabilities": {
      "type": "object",
      "additionalProperties": {"enum": ["supported", "experimental", "unsupported"]}
    }
  }
}

